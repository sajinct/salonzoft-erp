{
  "name": "salonzoft",
  "private": true,
  "version": "0.1.0",
  "description": "Salonzoft — multi-tenant Salon & Spa ERP SaaS (Angular + Supabase)",
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "test:db": "node --liftoff-only --test --test-concurrency=1 \"supabase/tests/*.test.mjs\"",
    "test:concurrency": "node --test --test-concurrency=1 \"supabase/tests/concurrency/*.mjs\"",
    "web:start": "npm --prefix apps/web start",
    "web:build": "npm --prefix apps/web run build",
    "web:test": "npm --prefix apps/web test -- --watch=false",
    "db:types": "supabase gen types typescript --local > apps/web/src/app/core/supabase/database.types.ts",
    "db:types:offline": "node --liftoff-only scripts/gen-db-types.mjs",
    "test": "npm run test:db && npm run web:test && npm run web:build",
    "db:seed:demo": "node scripts/seed-demo.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium webkit",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.65.0",
    "@supabase/supabase-js": "^2.119.0",
    "@types/node": "^26.6.6",
    "pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
